{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brush-poi-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // Route poi-api.brushaway.app/* -> brush-poi-backend is managed manually in
  // the Cloudflare dashboard (Zone > Workers Routes), not here — this token's
  // permissions don't cover Zone:Workers Routes, so wrangler can't sync a
  // "routes" block without failing every deploy. Not lost, just not IaC yet.
  // KAN-367 — the Firebase project whose ID tokens this Worker accepts on
  // Authorization: Bearer. Public by nature (it is in the app's
  // google-services.json); it is a var, not a secret, because its job is to
  // reject tokens minted for any OTHER project, not to stay hidden.
  "vars": {
    "FIREBASE_PROJECT_ID": "brush-away"
  },
  // Per-uid rate limits, carrying over the exact budgets the retired Firebase
  // proxy enforced in Firestore: 30/min on the read paths, 5/min on coverage
  // demand (which can trigger a server-side Nominatim reverse-geocode).
  // Counted per Cloudflare location and eventually consistent by design —
  // fine for a guard rail, and cheaper than a D1 write per POI request.
  "ratelimits": [
    {
      "name": "POI_RATE_LIMITER",
      "namespace_id": "3670",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "COVERAGE_REQUEST_RATE_LIMITER",
      "namespace_id": "3671",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // KAN-387. Drives the OSM supplement's batches: each container invocation
  // does 5-10 municipalities and exits, so the cron is what starts the next
  // one and what reclaims scopes whose container died. Five minutes is well
  // inside the 20m scope lease, so a tick never races a live batch — the
  // country batch lock is the actual guard, this is just its cadence.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "REGISTRY_DB",
      "database_name": "brush-poi-registry",
      "database_id": "219307c1-3ada-4df5-bd52-724e5bcc7fb8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "POI_EXPORTS",
      "bucket_name": "brush-poi-exports"
    }
  ],
  // KAN-354. The extraction pipeline (Python + DuckDB) runs as a Cloudflare
  // Container, not a separate cloud service — same account, same `wrangler
  // deploy`, no second bill. `wrangler deploy` builds extraction/Dockerfile
  // with Docker (must be running locally) and pushes the image alongside
  // the Worker. See extractionContainer.ts and deploy/README.md.
  "containers": [
    {
      "class_name": "ExtractionContainer",
      "image": "./extraction/Dockerfile",
      // Wrangler's own default build context is the Dockerfile's directory
      // (cloudflare/extraction/) — too narrow, since the Dockerfile also
      // needs the repo root's src/ (category mapping + brand/keyword
      // dictionaries classify_and_load.py classifies against, see that
      // Dockerfile's own comment). Verified against wrangler's bundled
      // source (resolveImageBuildConfig), not just the docs — the default
      // is genuinely path.dirname(image), confirmed by reading
      // node_modules/wrangler/wrangler-dist/cli.js directly.
      "image_build_context": "..",
      "max_instances": 3,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXTRACTION_CONTAINER",
        "class_name": "ExtractionContainer"
      },
      {
        "name": "NOMINATIM_RESOLVER",
        "class_name": "NominatimResolver"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExtractionContainer", "NominatimResolver"]
    }
  ]
}
