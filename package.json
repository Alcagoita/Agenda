{
  "name": "brush",
  "version": "0.19.4",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "rules:brands": "node scripts/generate-firestore-brand-rules.mjs --write",
    "rules:brands:check": "node scripts/generate-firestore-brand-rules.mjs --check",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "postinstall": "patch-package && node scripts/patch-nested-modules.js",
    "eas-build-post-install": "node scripts/eas-post-install.js"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@notifee/react-native": "^9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "24.0.0",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/app-check": "24.0.0",
    "@react-native-firebase/auth": "24.0.0",
    "@react-native-firebase/crashlytics": "24.0.0",
