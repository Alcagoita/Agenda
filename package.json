    "expo-sqlite": "~56.0.5",
    "expo-task-manager": "^56.0.19",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-calendars": "^1.1314.0",
