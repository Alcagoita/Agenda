    "react-native-screens": "^4.25.2",
    "react-native-share-menu": "^4.1.4",
    "react-native-svg": "15.15.4",
    "react-native-wear-connectivity": "^0.1.17",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
